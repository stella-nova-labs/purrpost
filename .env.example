# Copy to backend/.env for local runs. Never commit real values.

# --- Telegram ---
BOT_TOKEN=
WEBAPP_URL=
BOT_MODE=off            # off | polling | webhook
WEBHOOK_SECRET=
OWNER_ID=               # your Telegram id: full access and the admin panel
ADMIN_IDS=

# --- Database (Railway sets DATABASE_URL) ---
DATABASE_URL=
AUTO_CREATE_SCHEMA=0

# --- Local development ---
DEV_AUTH=0              # 1: accept `tma dev:<id>` without a signature (LOCAL ONLY)
DEV_FAKE_PROVIDERS=0    # 1: fake LLM, images, LoRA and publishers; no keys needed
RUN_WORKER=0            # 1: run background jobs inside the web process
WORKER_INTERVAL_SEC=20

# --- Encryption of user tokens and keys ---
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_PRICE_IN=4
ANTHROPIC_PRICE_OUT=20

# --- fal.ai ---
FAL_KEY=

# --- S3 bucket (Railway bucket: endpoint, name and keys from the bucket's Credentials tab) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
S3_PUBLIC_BASE_URL=

# --- Meta: Instagram API with Instagram Login ---
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
# --- Threads (optional) ---
THREADS_APP_ID=
THREADS_APP_SECRET=
PUBLIC_BASE_URL=        # defaults to WEBAPP_URL; OAuth callbacks go to <PUBLIC_BASE_URL>/api/oauth/...

# --- Business rules ---
DEFAULT_BUDGET_USD=15
AUTOPILOT_STREAK=10
TIMEZONE=Europe/Moscow
